---
import { MapPin, Wrench, User, Briefcase, GraduationCap, GitBranch, Server, FileCode, Zap, Shield, Phone, Mail, Linkedin, Info, Contact, IdCard } from 'lucide-react';

export interface ResumeData {
  name: string;
  title: string;
  location: string;
  email: string;
  phone: string;
  linkedin: string;
  sections: {
    details: { icon: string; title: string };
    skills: { icon: string; title: string; categories: Array<{ name: string; icon: string; items: string[] }> };
    profile: { icon: string; title: string; content: string };
    employment: { icon: string; title: string; jobs: Array<{ title: string; company: string; logo: string; period: string; responsibilities: string[] }> };
    education: { icon: string; title: string; items: Array<{ degree: string; field: string; institution: string; period: string; highlights: string[] }> };
    references: { icon: string; title: string; content: string; contact: string };
  };
}

export interface ResumeLayoutProps {
  data: ResumeData;
  lang: 'en' | 'es';
  title: string;
  isPdf?: boolean;
}

const { data, lang, title, isPdf = false } = Astro.props as ResumeLayoutProps;

const jobConnector = lang === 'es' ? 'en' : 'at';

// Icon mapping
const getIcon = (iconName: string) => {
  const icons = {
    MapPin,
    Wrench,
    User,
    Briefcase,
    GraduationCap,
    GitBranch,
    Server,
    FileCode,
    Zap,
    Shield
  };
  return icons[iconName as keyof typeof icons];
};
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <style>
    /* Reset and base styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Helvetica', Arial, sans-serif;
      line-height: 1.4;
      color: #000;
      background: white;
      font-size: 12px;
    }
    
    .container {
      max-width: 210mm;
      margin: 0 auto;
      padding: 20px;
      background: white;
    }
    
    .header {
      text-align: center;
      margin-bottom: 40px;
    }
    
    .profile-img {
      width: 120px;
      height: 120px;
      border-radius: 8px;
      margin: 0 auto 15px;
      border: 2px solid #ccc;
      object-fit: cover;
    }
    
    h1 {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 8px;
      letter-spacing: 1px;
    }
    
    .subtitle {
      font-size: 14px;
      color: #666;
      margin-bottom: 5px;
    }
    
    .grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 30px;
      margin-top: 20px;
    }
    
    .section {
      margin-bottom: 25px;
    }
    
    .section-title {
      font-size: 16px;
      font-weight: bold;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      border-bottom: 1px solid #ddd;
      padding-bottom: 5px;
    }
    
    .section-icon {
      margin-right: 8px;
      font-size: 16px;
    }
    
    .details p {
      margin-bottom: 4px;
      font-size: 11px;
      color: #333;
    }

    .detail-item {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
      font-size: 11px;
      color: #333;
    }

    .detail-icon {
      width: 14px;
      height: 14px;
      color: #666;
      flex-shrink: 0;
    }

    .detail-link {
      color: #333;
      text-decoration: none;
    }

    .detail-link:hover {
      color: #000;
      text-decoration: underline;
    }
    
    .skill-category {
      margin-bottom: 8px;
    }

    .skill-category-name {
      font-weight: 600;
      font-size: 10px;
      color: #666;
      text-transform: uppercase;
      margin-bottom: 4px;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .skill-category-icon {
      width: 12px;
      height: 12px;
    }

    .skill-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 3px;
    }

    .skill-tag {
      background: #e8e8e8;
      color: #333;
      border-radius: 3px;
      padding: 2px 6px;
      font-size: 8px;
      font-weight: 500;
      white-space: nowrap;
      letter-spacing: 0.3px;
    }
    
    .profile-text {
      font-size: 11px;
      line-height: 1.6;
      text-align: justify;
      color: #333;
    }
    
    .job {
      border-left: 3px solid #ddd;
      padding-left: 15px;
      margin-bottom: 20px;
    }
    
    .job-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 5px;
    }
    
    .job-logo {
      width: 24px;
      height: 24px;
      object-fit: contain;
      border-radius: 4px;
      border: 1px solid #ddd;
    }
    
    .job-title {
      font-weight: bold;
      font-size: 13px;
      margin: 0;
    }
    
    .job-period {
      font-size: 10px;
      color: #666;
      margin-bottom: 8px;
    }
    
    .job-responsibilities {
      list-style: none;
    }
    
    .job-responsibilities li {
      font-size: 10px;
      margin-bottom: 3px;
      padding-left: 12px;
      position: relative;
      color: #333;
    }
    
    .job-responsibilities li:before {
      content: "•";
      position: absolute;
      left: 0;
      color: #000;
    }
    
    .education-item {
      border-left: 3px solid #ddd;
      padding-left: 15px;
    }
    
    .education-title {
      font-weight: bold;
      font-size: 13px;
      margin-bottom: 3px;
    }
    
    .education-institution {
      font-size: 11px;
      color: #666;
      margin-bottom: 3px;
    }
    
    .education-period {
      font-size: 10px;
      color: #666;
      margin-bottom: 8px;
    }
    
    .education-highlights {
      list-style: none;
    }
    
    .education-highlights li {
      font-size: 10px;
      margin-bottom: 3px;
      padding-left: 12px;
      position: relative;
      color: #333;
    }
    
    .education-highlights li:before {
      content: "•";
      position: absolute;
      left: 0;
      color: #000;
    }
    
    .references {
      border-left: 3px solid #ddd;
      padding-left: 15px;
    }
    
    .references-content {
      font-weight: bold;
      font-size: 13px;
      margin-bottom: 3px;
    }
    
    .references-contact {
      font-size: 10px;
      color: #666;
    }

    /* Responsive Design */
    @media screen and (max-width: 768px) {
      .container {
        max-width: 100%;
        padding: 15px;
      }

      .grid {
        grid-template-columns: 1fr;
        gap: 20px;
      }

      .profile-img {
        width: 100px;
        height: 100px;
      }

      h1 {
        font-size: 20px;
      }

      .subtitle {
        font-size: 12px;
      }

      .section-title {
        font-size: 14px;
      }

      .header {
        margin-bottom: 30px;
      }

      .section {
        margin-bottom: 20px;
      }
    }

    @media screen and (max-width: 480px) {
      .container {
        padding: 10px;
      }

      .grid {
        gap: 15px;
      }

      .profile-img {
        width: 80px;
        height: 80px;
      }

      h1 {
        font-size: 18px;
      }

      .subtitle {
        font-size: 11px;
      }

      .section-title {
        font-size: 13px;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
      }

      .section-icon {
        margin-right: 0;
        margin-bottom: 3px;
      }

      .job {
        padding-left: 10px;
        margin-bottom: 15px;
      }

      .job-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
      }

      .job-logo {
        width: 20px;
        height: 20px;
      }

      .education-item {
        padding-left: 10px;
      }

      .references {
        padding-left: 10px;
      }

      .header {
        margin-bottom: 25px;
      }

      .section {
        margin-bottom: 18px;
      }
    }

    @media print {
      .container {
        max-width: none;
        padding: 10mm;
        height: 100vh;
        overflow: hidden;
      }

      .grid {
        grid-template-columns: 1fr 2fr;
        gap: 30px;
      }

      body {
        font-size: 10px;
        margin: 0;
        padding: 0;
        height: 100vh;
        overflow: hidden;
      }

      .profile-img {
        width: 60px;
        height: 60px;
      }

      h1 {
        font-size: 18px;
      }

      .subtitle {
        font-size: 11px;
      }

      .section-title {
        font-size: 12px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header Section -->
    <div class="header">
      <img src="/profilepicture.png" alt="Profile Picture" class="profile-img">
      <h1>{data.name}</h1>
      <div class="subtitle">{data.title} • {data.location} • {data.email}</div>
    </div>

    <div class="grid">
      <!-- Left Column -->
      <div class="left-column">
        <!-- Details Section -->
        <div class="section">
          <h2 class="section-title">
            <Info className="section-icon" size={16} />
            {data.sections.details.title}
          </h2>
          <div class="details">
            <div class="detail-item">
              <MapPin className="detail-icon" size={14} />
                <span>{data.location}</span>
            </div>
            <div class="detail-item">
              <Mail className="detail-icon" size={14} />
              <a href={`mailto:${data.email}`} class="detail-link">{data.email}</a>
            </div>
            <div class="detail-item">
              <Phone className="detail-icon" size={14} />
              <a href={`tel:${data.phone}`} class="detail-link">{data.phone}</a>
            </div>
            <div class="detail-item">
              <Linkedin className="detail-icon" size={14} />
              <a href={`https://${data.linkedin}`} target="_blank" class="detail-link">{data.linkedin}</a>
            </div>
          </div>
        </div>

        <!-- Skills Section -->
        <div class="section">
          <h2 class="section-title">
            <Wrench className="section-icon" size={16} />
            {data.sections.skills.title}
          </h2>
          <div class="skills">
            {data.sections.skills.categories.map((category) => {
              const IconComponent = getIcon(category.icon);
              return (
                <div class="skill-category">
                  <div class="skill-category-name">
                    {IconComponent && <IconComponent className="skill-category-icon" size={12} />}
                    {category.name}
                  </div>
                  <div class="skill-tags">
                    {category.items.map((skill) => (
                      <span class="skill-tag">{skill}</span>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Education -->
        <div class="section">
          <h2 class="section-title">
            <GraduationCap className="section-icon" size={16} />
            {data.sections.education.title}
          </h2>
          {data.sections.education.items.map((edu) => (
            <div class="education-item" style="margin-bottom: 20px;">
              <h3 class="education-title">{edu.degree}</h3>
              <p class="education-institution">{edu.institution}</p>
              <p class="education-period">{edu.period}</p>
              <ul class="education-highlights">
                {edu.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column -->
      <div class="right-column">
        <!-- Profile Section -->
        <div class="section">
          <h2 class="section-title">
            <User className="section-icon" size={16} />
            {data.sections.profile.title}
          </h2>
          <p class="profile-text">{data.sections.profile.content}</p>
        </div>

        <!-- Employment History -->
        <div class="section">
          <h2 class="section-title">
            <Briefcase className="section-icon" size={16} />
            {data.sections.employment.title}
          </h2>
          <div class="jobs">
            {data.sections.employment.jobs.map((job) => (
              <div class="job">
                <div class="job-header">
                  <img src={job.logo} alt={`${job.company} logo`} class="job-logo" />
                  <h3 class="job-title">{job.title} {jobConnector} {job.company}</h3>
                </div>
                <p class="job-period">{job.period}</p>
                <ul class="job-responsibilities">
                  {job.responsibilities.map((resp) => (
                    <li>{resp}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </div>
</body>
